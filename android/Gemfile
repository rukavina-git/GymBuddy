source "https://rubygems.org"

# Plan 8.3, ADR 0017. fastlane (MIT) only uploads; Gradle builds.
gem "fastlane", "~> 2.228"

plugins_path = File.join(File.dirname(__FILE__), "fastlane", "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)

# google-apis-core 1.x sends raw uploads (the App Distribution APK) as a
# stream without Content-Length, which net-http rejects. 0.18 is the
# last 0.x and works; every gem that needs it allows < 1.
gem "google-apis-core", "< 1"
