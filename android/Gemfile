source "https://rubygems.org"

# Plan 8.3, ADR 0017. fastlane (MIT) only uploads; Gradle builds.
gem "fastlane", "~> 2.228"

plugins_path = File.join(File.dirname(__FILE__), "fastlane", "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)

# The App Distribution upload failed with net-http 0.10.0 /
# faraday-net_http 3.5.0 ("Content-Length not given"); held back until
# a newer release is checked.
gem "net-http", "< 0.10"
gem "faraday-net_http", "< 3.5"
