<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup and device transfer on Android 12+. Everything is kept,
   including every owner's Room file (gym_buddy_*.db, ADR 0014), except
   the signed-out dialog counter, so a reinstall starts over (Plan 9
   step 04a).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="signed_out_prompt.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="signed_out_prompt.xml" />
    </device-transfer>
</data-extraction-rules>
