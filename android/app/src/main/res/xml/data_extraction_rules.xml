<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup and device transfer on Android 12+. An empty section keeps
   the default (back up everything), including every owner's Room file
   (gym_buddy_*.db, ADR 0014). Exclude nothing for now.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
