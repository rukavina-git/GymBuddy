# Copy to /opt/gymbuddy-test/.env on the server (owner deploy, mode 0600).
# Placeholders only; real values never go in the repo.
#
# Compose expands $ in unquoted values: wrap a value containing $ in
# single quotes ('...') or it changes silently.
# Backend image, e.g. ghcr.io/<owner>/gymbuddy-backend:sha-<7>
BACKEND_IMAGE=gymbuddy-backend:local
# Test host name; deploy.sh checks health on it through nginx.
# Must match TEST_API_HOST in the prod env file.
API_HOST=api-test.example.com
# Its own password, not prod's. Read only when the db volume is created.
DB_PASSWORD=change-me
# Base64 service account JSON of the TEST Firebase project, one line
FIREBASE_CREDENTIALS_B64=change-me
