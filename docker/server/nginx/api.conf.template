# Site: static legal pages (Plan 9 step 02), built by legal/build.py
# and copied to /opt/gymbuddy/site by legal-site.yml. Extensionless
# URLs: /privacy serves privacy/index.html. SITE_HOST is
# gymtracker.rukavina.app: the apex rukavina.app is a Vercel site.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SITE_HOST};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'self'; frame-ancestors 'none'" always;

    root /usr/share/nginx/site;
    location / {
        try_files $uri $uri/index.html =404;
    }
}
