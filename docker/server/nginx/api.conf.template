# ${API_HOST}, ${TEST_API_HOST} and ${SITE_HOST} are filled in by the nginx
# image's envsubst step. nginx's own variables ($host, $remote_addr,
# ...) have no braces here, so envsubst leaves them alone.
#
# Prod, test and the site share one cert (lineage named after
# API_HOST, all names on it), so no block can point at a missing
# cert and take prod down with it.

server_tokens off;

ssl_certificate     /etc/letsencrypt/live/${API_HOST}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${API_HOST}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:5m;
ssl_session_timeout 1d;

# Docker's embedded DNS. With a variable in proxy_pass nginx looks a
# backend up per request (cached 10 s) instead of once at startup, so
# a deploy that replaces a backend container (new IP) doesn't leave
# nginx proxying to a dead address, and nginx starts even while the
# test stack is down (that host gets 502).
resolver 127.0.0.11 valid=10s ipv6=off;

# POST /v1/feedback is open to guests (no token), so it gets a per-IP
# limit here on top of the backend's 5/hour per uid or IP. Coarse on
# purpose: it stops floods before they reach Java. Shared by prod and
# test (keyed by IP only).
limit_req_zone $binary_remote_addr zone=feedback:1m rate=10r/m;
limit_req_status 429;

# The feedback admin page and its API (Plan 10 step 06d): one owner, so
# a low per-IP limit; the backend still checks the token and uid list.
limit_req_zone $binary_remote_addr zone=admin:1m rate=30r/m;

# Port 80, any Host: answer ACME challenges, so certbot --webroot can
# add a name through the running nginx. Everything else: drop.
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 444;
    }
}

# Unknown SNI on 443: refuse the TLS handshake.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${API_HOST} ${TEST_API_HOST} ${SITE_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Prod.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_HOST};

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;

    # Never plain "backend": see the alias note in compose.yaml.
    set $backend_upstream http://backend-prod:8080;

    # Admin page: strict CSP. Firebase Google sign-in by popup needs
    # gstatic (SDK), apis.google.com (its loader), the Firebase auth
    # APIs and the project's firebaseapp.com auth iframe. A location's
    # add_header replaces the server's, so HSTS is repeated here.
    location /admin/ {
        limit_req zone=admin burst=20 nodelay;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self'; img-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src https://*.firebaseapp.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/admin/ {
        limit_req zone=admin burst=20 nodelay;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /v1/feedback {
        limit_req zone=feedback burst=5 nodelay;
        client_max_body_size 16k;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

