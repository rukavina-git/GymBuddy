# Copy to /opt/gymbuddy/.env on the server (owner deploy, mode 0600).
# Placeholders only; real values never go in the repo.

# Backend image, e.g. ghcr.io/<owner>/gymbuddy-backend:<sha>
BACKEND_IMAGE=gymbuddy-backend:local
# Public API host name; init-cert.sh gets its certificate
API_HOST=api.example.com
DB_PASSWORD=change-me
# Base64 Firebase service account JSON (see backend/README.md)
FIREBASE_CREDENTIALS_B64=change-me
