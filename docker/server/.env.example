# Copy to /opt/gymbuddy/.env on the server (owner deploy, mode 0600).
# Placeholders only; real values never go in the repo.
#
# Compose expands $ in unquoted values: wrap a value containing $ in
# single quotes ('...') or it changes silently.

# Backend image, e.g. ghcr.io/<owner>/gymbuddy-backend:<sha>
BACKEND_IMAGE=gymbuddy-backend:local
# Public API host names. init-cert.sh gets one cert for both; nginx
# serves test from the gymbuddy-test stack (test/compose.yaml).
API_HOST=api.example.com
TEST_API_HOST=api-test.example.com
# Postgres reads this only when the db volume is first created.
# To change it later: ALTER ROLE gymbuddy PASSWORD '...' in psql,
# then update it here and recreate the backend.
DB_PASSWORD=change-me
# Base64 Firebase service account JSON (see backend/README.md)
FIREBASE_CREDENTIALS_B64=change-me
