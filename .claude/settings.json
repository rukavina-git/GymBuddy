{
  "permissions": {
    "allow": [
      "Bash(./gradlew test)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew build)",
      "Bash(./gradlew build *)",
      "Bash(./gradlew testDebugUnitTest)",
      "Bash(./gradlew testDebugUnitTest *)",
      "Bash(./gradlew assembleDebug)",
      "Bash(./gradlew assembleDebug *)",
      "Bash(./gradlew compileDebugKotlin)",
      "Bash(./gradlew compileDebugKotlin *)",
      "Bash(./gradlew jacocoTestReport)",
      "Bash(./gradlew lint)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git push origin develop)",
      "Bash(npm run lint)"
    ],
    "deny": [
      "Read(**/keystore.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/keystores/**)",
      "Read(**/.env)",
      "Read(**/google-services.json)",
      "Read(**/*service-account*.json)",
      "Read(**/*firebase-adminsdk*.json)",
      "Edit(**/keystore.properties)",
      "Edit(**/.env)",
      "Edit(**/google-services.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
